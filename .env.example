# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Use a random password of at least 32 characters for encrypted session cookies.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SESSION_PASSWORD=replace_with_at_least_32_random_characters

# Ollama local service and model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Availability window in local time
MEETING_TIMEZONE=Asia/Kolkata
WORKDAY_START=09:00
WORKDAY_END=17:00
SLOT_INTERVAL_MINUTES=30
